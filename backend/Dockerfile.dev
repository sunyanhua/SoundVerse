# 开发环境Dockerfile
FROM python:3.11-slim

# 设置工作目录
WORKDIR /app

# 配置apt使用阿里云镜像源
RUN echo "deb http://mirrors.aliyun.com/debian trixie main" > /etc/apt/sources.list.d/aliyun.list && \
    echo "deb http://mirrors.aliyun.com/debian trixie-updates main" >> /etc/apt/sources.list.d/aliyun.list && \
    echo "deb http://mirrors.aliyun.com/debian-security trixie-security main" >> /etc/apt/sources.list.d/aliyun.list

# 安装系统依赖（使用阿里云镜像）
RUN apt-get update -o Acquire::Retries=3 && \
    apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libffi-dev \
    libssl-dev \
    libmariadb-dev \
    pkg-config \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/* /etc/apt/sources.list.d/aliyun.list

# 复制依赖文件
COPY pyproject.toml ./

# 安装Python依赖
RUN pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple/ --trusted-host mirrors.aliyun.com -e ".[dev]"

# 复制应用代码
COPY . .

# 创建日志和数据目录
RUN mkdir -p logs data

# 设置环境变量
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV TZ=Asia/Shanghai

# 暴露端口
EXPOSE 8000

# 开发环境启动命令
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
